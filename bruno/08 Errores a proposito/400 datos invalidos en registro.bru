meta {
  name: 400 datos invalidos en registro
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/registro
  body: json
  auth: none
}

body:json {
  {
    "nombre": "A",
    "apellidos": "",
    "correo": "no-es-correo",
    "contrasena": "debil"
  }
}

tests {
  test("responde 400", function() {
    expect(res.status).to.equal(400);
  });
  test("error en formato JSON", function() {
    expect(res.body.estado).to.equal(400);
    expect(res.body.mensaje).to.be.a("string");
  });
  test("un mensaje por campo", function() {
    expect(res.body.errores).to.have.property("correo");
    expect(res.body.errores).to.have.property("contrasena");
  });
}

meta {
  name: 400 evento con fin antes del inicio
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/eventos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenEstudiante}}
}

body:json {
  {
    "titulo": "Mal rango",
    "inicio": "2030-01-12T10:00:00",
    "fin": "2030-01-12T09:00:00",
    "tipo": "PERSONAL"
  }
}

tests {
  test("responde 400", function() {
    expect(res.status).to.equal(400);
  });
  test("error en formato JSON", function() {
    expect(res.body.estado).to.equal(400);
    expect(res.body.mensaje).to.be.a("string");
  });
}

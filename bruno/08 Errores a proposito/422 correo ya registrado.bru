meta {
  name: 422 correo ya registrado
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/auth/registro/codigo
  body: json
  auth: none
}

body:json {
  {
    "correo": "admin@dianova.test"
  }
}

tests {
  // No se manda código a un correo que ya tiene cuenta
  test("responde 422", function() {
    expect(res.status).to.equal(422);
  });
  test("error en formato JSON", function() {
    expect(res.body.estado).to.equal(422);
    expect(res.body.errores).to.have.property("correo");
  });
}

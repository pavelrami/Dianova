meta {
  name: 422 correo ya registrado
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/auth/registro
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Ana",
    "apellidos": "Repetida",
    "correo": "admin@dianova.test",
    "contrasena": "Segura#2026"
  }
}

tests {
  test("responde 422", function() {
    expect(res.status).to.equal(422);
  });
  test("error en formato JSON", function() {
    expect(res.body.estado).to.equal(422);
    expect(res.body.mensaje).to.be.a("string");
  });
}

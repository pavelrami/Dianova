meta {
  name: 403 docente publica en materia ajena
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/tareas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "titulo": "No permitido",
    "fechaEntrega": "2030-01-15T23:59:00",
    "prioridad": "BAJA",
    "materiaId": 2
  }
}

tests {
  test("responde 403", function() {
    expect(res.status).to.equal(403);
  });
  test("error en formato JSON", function() {
    expect(res.body.estado).to.equal(403);
    expect(res.body.mensaje).to.be.a("string");
  });
}

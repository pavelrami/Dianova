meta {
  name: 422 canal sin consentimiento
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/recordatorios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenEstudiante}}
}

body:json {
  {
    "eventoId": 1,
    "canal": "WHATSAPP",
    "programadoPara": "2030-01-15T08:00:00"
  }
}

tests {
  test("responde 422", function() {
    expect(res.status).to.equal(422);
  });
  test("error en formato JSON", function() {
    expect(res.body.estado).to.equal(422);
    expect(res.body.mensaje).to.be.a("string");
  });
}

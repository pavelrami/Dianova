meta {
  name: Crear tarea personal (estudiante)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/tareas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenEstudiante}}
}

body:json {
  {
    "titulo": "Estudiar para el parcial",
    "fechaEntrega": "2030-01-10T18:00:00",
    "prioridad": "MEDIA"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("tareaPersonalId", res.body.id);
  }
}

tests {
  test("responde 201", function() {
    expect(res.status).to.equal(201);
  });
  test("es personal", function() {
    expect(res.body.origen).to.equal("PERSONAL");
  });
}

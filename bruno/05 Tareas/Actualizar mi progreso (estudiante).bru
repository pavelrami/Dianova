meta {
  name: Actualizar mi progreso (estudiante)
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/tareas/{{tareaId}}/progreso
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenEstudiante}}
}

body:json {
  {
    "estado": "EN_PROCESO"
  }
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
  });
}

meta {
  name: Recuperar contrasena
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/recuperar
  body: json
  auth: none
}

body:json {
  {
    "correo": "estudiante@dianova.test",
    "canal": "EMAIL"
  }
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
  });
  test("mensaje generico (no revela si la cuenta existe)", function() {
    expect(res.body.mensaje).to.contain("código de 6 dígitos");
  });
}

meta {
  name: Login administrador
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "correo": "admin@dianova.test",
    "contrasena": "Admin#2026"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("tokenAdmin", res.body.token);
  }
}

tests {
  test("responde 200", function() {
    expect(res.status).to.equal(200);
  });
  test("devuelve un JWT y el rol correcto", function() {
    expect(res.body.token).to.be.a("string");
    expect(res.body.tipo).to.equal("Bearer");
    expect(res.body.usuario.correo).to.equal("admin@dianova.test");
  });
}

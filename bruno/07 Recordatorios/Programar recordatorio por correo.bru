meta {
  name: Programar recordatorio por correo
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/recordatorios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenEstudiante}}
}

body:json {
  {
    "tareaId": {{tareaId}},
    "canal": "EMAIL",
    "programadoPara": "2030-01-15T08:00:00",
    "mensaje": ""
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("recordatorioId", res.body.id);
  }
}

tests {
  test("responde 201", function() {
    expect(res.status).to.equal(201);
  });
}
